// ⚠️ RECONSTRUCTED FROM SCRATCH — I (Claude) don't have a local copy of the
// currently-deployed rules (they only ever existed pasted into the Firebase
// Console, named database "ai-agent-lib"). This file implements the 4-tier
// permission model discussed 2026-07-01. REVIEW BEFORE PASTING — if the
// deployed ruleset has collections/rules not covered here (e.g. something
// added ad-hoc in the Console), re-add them; this is a full overwrite, not
// a patch (per project convention: always replace the whole ruleset).
//
// Roles (on /users/{uid}.role): 'user' | 'staff' | 'approver' | 'committee' | 'admin'
//   admin     — everything, incl. user management.
//   committee — everything admin can do on /agents, NOT /users.
//   approver  — approve/reject + progress-update scoped to own approveAreas
//               (area matching is enforced in the UI via agentApproveAreas();
//               these rules only gate role tier + field scope, same pattern
//               already used for the existing progress-update rule).
//   staff     — same as 'user' for all /agents write rules (submit ideas,
//               withdraw own pending idea, update own progress) — the ONLY
//               difference is UI-side: staff also sees the "All Data" export
//               button (2026-07-06). Not a security boundary — isKnownUser()
//               already lets every known-user tier read every agent doc
//               (pending/rejected included); "All Data" just widens which
//               export BUTTON shows in the client, gated in ExportDataModal.jsx.
//   user      — submit ideas, withdraw/reject their own pending idea, update
//               progress on agents they created.
//
// Publish via: Firebase Console → Firestore Database → Rules → make sure the
// named database dropdown is set to "ai-agent-lib" (NOT "(default)") before
// publishing — publishing against the wrong DB silently no-ops.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }
    function isCommittee() {
      return isSignedIn() && (userRole() == 'committee' || isAdmin());
    }
    function isApproverOrAbove() {
      return isSignedIn() && userRole() in ['approver', 'committee', 'admin'];
    }
    function isWorkshopOrAbove() {
      return isSignedIn() && userRole() in ['workshop', 'staff', 'committee', 'admin'];
    }
    function isKnownUser() {
      return isSignedIn() && userRole() in ['user', 'workshop', 'staff', 'approver', 'committee', 'admin'];
    }
    function isStaffOrAbove() {
      return isSignedIn() && userRole() in ['staff', 'committee', 'admin'];
    }
    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Whether the signed-in user is one of an agent's (possibly multiple)
    // creators, matched by email — not uid. This needs no login/UID backfill
    // at all: creatorEmails is populated straight from the Creator/Team-member
    // picker at submit time, and request.auth.token.email is always present
    // on a Google-signed-in user.
    // ⚠️ ALWAYS read optional fields with .get(field, default), never
    //    agentData.field — dot access on a key the document does NOT have
    //    raises an evaluation error, and an error DENIES the write. That is
    //    not hypothetical: 71 of 245 agent docs (legacy CSV imports) have no
    //    `deploymentStatus` key at all, and every rule branch that read it via
    //    dot notation therefore denied edits on those 71 docs for everyone
    //    except admin (who short-circuits on isAdmin() first). Symptom was a
    //    bare "Missing or insufficient permissions" in the Edit modal with no
    //    clue which field caused it. Fixed 2026-08-12; keep using .get().
    function isCreatorEmail(agentData) {
      return isSignedIn()
        && agentData.get('creatorEmails', []) is list
        && request.auth.token.email in agentData.get('creatorEmails', []);
    }
    // Tier B identity (sensitive edits: launch/progress/creator) — mirrors the
    // client's canUpdateProgress(): a creator (by email), the registrant
    // (createdBy), or the approver (approvedBy). admin is covered separately by
    // the blanket isAdmin() branch.
    function isOwnerCreatorOrApprover(agentData) {
      return isCreatorEmail(agentData)
        || agentData.get('createdBy', '') == request.auth.uid
        || agentData.get('approvedBy', '') == request.auth.uid;
    }

    // ── /agents ──────────────────────────────────────────────────
    match /agents/{agentId} {
      // Read: any signed-in user with a role doc. Pending items are
      // area/ownership-scoped in the UI (PendingApprovalModal), not here —
      // same pattern as the rest of this app's permission model.
      allow read: if isKnownUser();

      // Create: any tier may submit a new idea, but only as their own
      // pending draft — can't self-approve or impersonate another creator.
      allow create: if isKnownUser()
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if
        // Admin: any field, any doc.
        isAdmin()
        // Approver: approve/reject action only (area scoping is UI-side).
        // Reject may additionally stamp a reason (rejectionReason/rejectedBy/
        // rejectedAt) so the creator knows why — approve simply omits them.
        || (isApproverOrAbove()
            && affectedKeys().hasOnly(['approvalStatus', 'approvedBy', 'updatedAt', 'rejectionReason', 'rejectedBy', 'rejectedAt']))
        // Self-withdraw: creator can reject (never approve) their OWN
        // still-pending idea — covers the base "user" tier's "reject idea
        // ของตัวเอง" requirement.
        || (affectedKeys().hasOnly(['approvalStatus', 'updatedAt'])
            && resource.data.createdBy == request.auth.uid
            && resource.data.approvalStatus == 'pending'
            && request.resource.data.approvalStatus == 'rejected')
        // Progress-update: any of the agent's creators (by email —
        // creatorEmails, no UID backfill needed), createdBy uid, or
        // approvedBy uid, only while devProgress < 100, only these fields —
        // any tier (user included). Cap at 95 unless a deployment request was
        // already approved (2026-07-02 Deploy Approval feature) — going past
        // 95 requires the doc's deploymentStatus to already be 'approved'
        // when this write lands.
        || (affectedKeys().hasOnly(['devProgress', 'launchDate', 'developmentPhase', 'updatedAt'])
            && (isCreatorEmail(resource.data) || resource.data.createdBy == request.auth.uid || resource.data.approvedBy == request.auth.uid)
            && (resource.data.get('devProgress', 0) == null || resource.data.get('devProgress', 0) < 100)
            && (request.resource.data.devProgress <= 95 || resource.data.get('deploymentStatus', 'none') == 'approved'))
        // Deployment request: any of the agent's creators (by email), or
        // createdBy/approvedBy uid, confirms "tested and ready" (via the
        // confirm dialog in the UI) — one write bumps devProgress to exactly
        // 95 AND files the request, no separate "save to 95 first" step
        // required. Only while no request is already in flight (re-request
        // allowed after a rejection).
        || (affectedKeys().hasOnly(['devProgress', 'deploymentStatus', 'deployRequestedBy', 'deployRequestedAt', 'updatedAt'])
            && (isCreatorEmail(resource.data) || resource.data.createdBy == request.auth.uid || resource.data.approvedBy == request.auth.uid)
            && resource.data.get('devProgress', 0) < 100
            && resource.data.get('deploymentStatus', 'none') in ['none', 'rejected', null]
            && request.resource.data.devProgress == 95
            && request.resource.data.deploymentStatus == 'requested')
        // Detail edit — Tier A (2026-07-xx): staff/committee may edit the
        // NON-sensitive detail set on a doc that isn't under deploy review.
        // This branch deliberately EXCLUDES creator/creatorEmails/launchDate/
        // devProgress/developmentPhase — those are Tier B (below). Committee
        // lost its former blanket write in this same change; approve/reject and
        // deploy-decision stay available via the isApproverOrAbove branches.
        // `category` was ALSO removed from both Tier A and Tier B (2026-08-17):
        // it drives the sidebar browse shortcuts AND layer 5 of
        // agentApproveAreas(), so letting a creator re-file their own agent
        // would let them re-route their own approval. Admin-only now, written
        // through the blanket isAdmin() branch above (EditAgentModal Write 2c,
        // gated by canEditCategory). Safe to remove: no client path other than
        // the admin editor, the create rule, and CategoryApprovalPanel (admin)
        // has ever sent it.
        // 2026-08-19: `endpoint` removed from this list. It is now written
        // ONLY by the markAgentReady / attachEndpointFile callables (admin SDK,
        // bypassing rules) so that reaching 100% and setting a location are one
        // authorised act. The input was removed from both forms at the same
        // time, so no client path sends it any more.
        || (userRole() in ['staff', 'committee']
            && affectedKeys().hasOnly([
                 'agentName', 'description', 'input', 'output', 'compatibleAgents', 'customerFacing',
                 'internalUse', 'coreAbility', 'relatedRole', 'reusable', 'reuseCondition', 'hml',
                 'humanJob', 'updatedAt',
               ])
            && !(resource.data.get('deploymentStatus', 'none') in ['requested', 'approved']))
        // Detail edit — Tier B (2026-07-03, widened): the agent's owner
        // (createdBy), a creator (by email), or the approver (approvedBy) may
        // edit the broader detail set INCLUDING the sensitive fields (creator
        // list, launchDate, devProgress) — but ONLY until a deployment request
        // is filed. Type (aiAgent/skillMd) is still NOT editable — locked once
        // approved. admin has unconditional access via the isAdmin() branch.
        // `endpoint` removed 2026-08-19 — see the note on Tier A above.
        || (affectedKeys().hasOnly([
              'agentName', 'description', 'input', 'output', 'compatibleAgents', 'customerFacing', 'internalUse',
              'coreAbility', 'relatedRole', 'creator', 'creatorEmails', 'reusable', 'reuseCondition', 'hml',
              'humanJob', 'launchDate', 'devProgress', 'developmentPhase', 'updatedAt',
            ])
            && isOwnerCreatorOrApprover(resource.data)
            && !(resource.data.get('deploymentStatus', 'none') in ['requested', 'approved'])
            && (request.resource.data.devProgress <= 95 || resource.data.get('deploymentStatus', 'none') == 'approved'))
        // SDLC metadata edit (2026-07-xx): the 3 SDLC fields are editable by a
        // DIFFERENT set than the detail tiers — the registrant (createdBy) or
        // anyone with the staff/approver/admin role. Deliberately excludes
        // committee and creator-by-email. Written as its own single-field-group
        // update by EditAgentModal so this branch matches exactly. Frozen once a
        // deployment request is filed, same as the detail edits.
        || (affectedKeys().hasOnly(['sdlcStage', 'sdlcProcessMapping', 'useCase', 'updatedAt'])
            && (userRole() in ['staff', 'approver', 'admin'] || resource.data.createdBy == request.auth.uid)
            && !(resource.data.get('deploymentStatus', 'none') in ['requested', 'approved']))
        // approveArea (2026-08-10, narrowed 2026-08-11): split into its OWN
        // branch — it decides who gets to approve/deploy THIS agent, so unlike
        // the rest of the SDLC group above (which any approver or the
        // registrant may edit), only staff may set it (admin already has
        // unconditional access via isAdmin() above). Letting an approver or
        // the submitter self-assign their own routing would be a self-serve
        // bug, not just an odd permission. EditAgentModal writes this as its
        // own separate updateDoc call so affectedKeys matches exactly.
        || (affectedKeys().hasOnly(['approveArea', 'updatedAt'])
            && userRole() == 'staff'
            && !(resource.data.get('deploymentStatus', 'none') in ['requested', 'approved']))
        // childSkillIds (2026-08-20): the explicit parent -> child-skill link
        // behind Type = Agent+Skill. Its own branch (EditAgentModal Write 4
        // sends it alone) rather than a member of Tier A/B, because the editors
        // are the Tier B set: it is ordinary parent-owned metadata about the
        // agent's own composition, and the link lives on the PARENT precisely
        // so nobody has to write onto someone else's skill doc. Frozen once a
        // deployment request is filed, same as every other detail edit.
        || (affectedKeys().hasOnly(['childSkillIds', 'updatedAt'])
            && isOwnerCreatorOrApprover(resource.data)
            && !(resource.data.get('deploymentStatus', 'none') in ['requested', 'approved']))
        // Deployment decision: approver-or-above approves/rejects a pending
        // deployment request (area scoping is UI-side, same pattern as the
        // new-entry approve/reject action above).
        || (isApproverOrAbove()
            && affectedKeys().hasOnly(['deploymentStatus', 'deployDecidedBy', 'deployDecidedAt', 'updatedAt'])
            && resource.data.get('deploymentStatus', 'none') == 'requested'
            && request.resource.data.deploymentStatus in ['approved', 'rejected'])
        // Archive / un-archive (2026-07-22): retiring an entry from the library
        // is a CURATION right, so unlike the detail tiers above it is granted by
        // role only — committee/approver/admin — and never by authorship
        // (createdBy/creator cannot archive their own entry). Nothing is
        // deleted: the doc stays readable for audit, duplicate warnings and AI
        // background context; only `archived` changes what the app shows.
        // Deliberately NOT frozen by deploymentStatus — a deployed-then-retired
        // agent is exactly a case that must be archivable.
        // staff joined 2026-08-11, role-gated here same as the rest — WHICH
        // agent a given staff member may archive (their own Approve Area only)
        // is enforced client-side (AgentDetailModal's staffAreaMatch), same
        // "scoping stays UI-side" pattern already used for approve/reject and
        // deploy-decision above; duplicating the full agentApproveAreas()
        // fallback chain into rules would violate the single-source-of-truth
        // rule this whole taxonomy was built to satisfy.
        || ((isApproverOrAbove() || userRole() == 'staff')
            && affectedKeys().hasOnly(['archived', 'archivedAt', 'archivedBy', 'archiveReason', 'updatedAt'])
            && request.resource.data.archived is bool)
        // Ready-to-Use post-freeze exception (2026-07-22): every detail tier
        // above freezes ENTIRELY once deploymentStatus is 'approved' — but
        // Description legitimately needs touch-ups after go-live. admin is
        // already covered by the blanket isAdmin() branch above, so this only
        // needs to add the creator identity; deliberately NOT approvedBy-only
        // (a bare approver shouldn't get ongoing edit rights here) and NOT
        // 'requested' (still under active review).
        //
        // 2026-08-19: `endpoint` dropped from this branch too — post-go-live
        // endpoint edits now go through markAgentReady/attachEndpointFile,
        // which apply the same permission set (creator, area approver/staff,
        // admin) instead of this branch's creator-only test. `agentName` is
        // deliberately still NOT here: renaming after go-live requires an
        // approval, via /renameRequests + the decideRenameRequest callable.
        || (resource.data.get('deploymentStatus', 'none') == 'approved'
            && affectedKeys().hasOnly(['description', 'updatedAt'])
            && (isCreatorEmail(resource.data) || resource.data.createdBy == request.auth.uid));

      allow delete: if isAdmin();
    }

    // ── Endpoint file version history (2026-08-26) ────────────────────
    // Closed to clients in BOTH directions, like /agentEvents and /rateLimits.
    // Reads go through the listEndpointVersions callable because the audience
    // includes "approver/staff of this agent's Approve Area", and rules cannot
    // evaluate agentApproveAreas() (a 7-layer resolver in src/lib).
    //
    // Note rules do NOT cascade from /agents/{id} into subcollections and there
    // is no {document=**} anywhere in this file, so this path is already
    // default-denied — this block is documentation plus a guard against anyone
    // later adding a recursive match.
    match /agents/{agentId}/endpointVersions/{versionId} {
      allow read, write: if false;
    }

    // ── Mail log (2026-08-20) ─────────────────────────────────────────
    // Audit trail for every notification attempt — sent, dry-run, held and
    // failed alike. Function-only writes (admin SDK bypasses these rules),
    // matching the /metrics + /agentStats posture: there is no legitimate
    // client reason to forge a record of an email.
    //
    // Read is admin-only rather than isKnownUser(): rows carry the recipient
    // lists for approval and archive decisions, which is more than a general
    // user needs to see.
    match /mailLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Rename requests (2026-08-19) ──────────────────────────────────
    // A creator may ask to rename an agent after it has gone live; an approver
    // for that agent's area (or an admin) decides. Modelled on
    // /categoryProposals — the only other request→approve flow here.
    //
    // Note `allow update: if false`. Unlike categoryProposals (admin-decides,
    // so a plain isAdmin() update works), deciding a rename needs an area
    // check that rules cannot evaluate, AND it must rewrite `agentName` on a
    // doc every tier above has frozen, AND it must rewrite `matchingAgent` on
    // every paired sub-skill in the same batch or the pairing silently breaks.
    // All three force it through the decideRenameRequest callable, so no
    // client update path should exist at all.
    match /renameRequests/{id} {
      allow read: if isKnownUser();
      allow create: if isKnownUser()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.agentId is string
        && request.resource.data.requestedName is string;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── /users ───────────────────────────────────────────────────
    match /users/{uid} {
      // A user may read their own doc (role bootstrap); admin/committee may
      // read any doc (list is only actually used by the admin-only
      // UserManagementModal, but committee is allowed to read too since it
      // shares agent-management visibility).
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin() || isCommittee());
      allow list: if isAdmin();

      // First-login auto-provision: self-create at the base "user" tier only.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'user';

      // Only admin grants/changes roles or approveAreas — for anyone,
      // including themselves (2026-07-04, revised: self-lockout is an
      // accepted risk the admin can knowingly take, not something to block).
      // No other role has any user-management rights at all.
      allow update: if isAdmin();

      allow delete: if false;
    }

    // ── SDLC catalog + schema config ─────────────────────────────
    // Read-only reference data for every signed-in tier; only admin edits
    // the catalog (via the migration scripts, not the app UI).
    match /sdlcProcesses/{id} {
      allow read: if isKnownUser();
      allow write: if isAdmin();
    }
    match /sdlcUseCases/{id} {
      allow read: if isKnownUser();
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if isKnownUser();
      allow write: if isAdmin();
    }
    // Semantic search index (2026-08-04). One doc per agent holding a 256-dim
    // embedding, read by the chat assistant and the Pre-Registration duplicate
    // check so cosine similarity can run client-side (which is what keeps
    // tier/readiness/archive logic in skills.js instead of duplicated on the
    // server). Contains no information that isn't already derived from /agents,
    // which known users can read anyway — so read is the same tier.
    // Writes are CLOSED to every client: only reindexAgentVectors writes here,
    // and it uses the admin SDK, which bypasses rules entirely. A client that
    // could write would be able to poison search ranking for everyone.
    match /agentVectors/{id} {
      allow read: if isKnownUser();
      allow write: if false;
    }
    // Pending role/team grants for people who have never logged in yet
    // (2026-09-17 roster backfill). Written only by the one-off
    // backfill-workshop-roster.cjs script (admin SDK, bypasses rules) and
    // consumed only by the claimPendingRoleGrant callable (also admin SDK).
    // Fully closed to every client — exposing read would leak the entire
    // intended-role roster (who gets promoted to what) to any signed-in user.
    match /pendingRoleGrants/{emailLower} {
      allow read, write: if false;
    }
    // Content-free chat counters (2026-08-04): turn counts, which tool the
    // model picked, list-vs-prose, not-found rate. No message text, no user
    // identity — the session-only/no-transcript rule for chat is unchanged.
    // Written exclusively by chatLibrary via the admin SDK (which bypasses
    // rules), so clients get no write path and cannot forge the numbers.
    match /metrics/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Rate-limit counters (2026-08-04) for embedQuery. Purely internal
    // bookkeeping, of no use to any client — closed to both read and write.
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // ── Feedback & Rating + usage statistics (2026-08-18) ──────────
    // Design rule this whole block exists to enforce: the client NEVER writes
    // a counter or a score. Rules can force `count == resource.data.count + 1`
    // but cannot stop a loop calling it 1000 times, and the established answer
    // in this codebase (/metrics above) is to remove the client write path
    // entirely. Both recordAgentEvent and submitRating are callables that
    // write via the admin SDK, so every collection here is `write: if false`.

    // Public per-agent aggregate: usage counters + the 1..5 star histogram.
    // Read by every signed-in user because the cards and Dashboard render it.
    // Deliberately holds a HISTOGRAM (r1..r5) and never a computed average —
    // an average over 1 rating is exactly the "ตัวเลขปลอมหรือประมาณ" that
    // docs/SYSTEM-OVERVIEW.md:353 forbids. Raw counts are facts; means are not.
    match /agentStats/{agentId} {
      allow read: if isKnownUser();
      allow write: if false;

      // What peers actually see. Carries NO uid BY DESIGN — the anonymity
      // promise is enforced by the shape of the data, not by the client
      // choosing not to render a field. If uid lived here, anyone could read
      // it straight out of Firestore regardless of what the UI shows.
      match /reviews/{reviewId} {
        allow read: if isKnownUser();
        allow write: if false;
      }
    }

    // The identified rating — one doc per user per agent, which is also what
    // makes "one vote each" structural rather than enforced by a check.
    // Readable ONLY by its author (so they can see/change their own rating)
    // and by admin (so abuse is traceable). This is the counterpart that lets
    // /agentStats/{id}/reviews stay anonymous.
    match /agentRatings/{ratingId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow write: if false;
    }

    // Dedup markers: {agentId}__{uid}__{YYYY-MM-DD}__{kind}. Their existence
    // turns the counters above into "unique users per day" instead of raw
    // hits — which is both un-inflatable and the more honest number to put in
    // front of an executive. Same doc-id-encoding trick as /rateLimits, and
    // like it, of no use to any client.
    match /agentEvents/{eventId} {
      allow read, write: if false;
    }
    // SDLC Timeline config (2026-07): viewers allowlist + editable milestones.
    // Read is cosmetic (any known user can read; menu-hiding only, accepted
    // risk). Admin bootstraps the doc + viewers list; thereafter anyone whose
    // email is already in the current viewers array may edit milestones (and
    // the list itself) — a small trusted set for a personal-view tool. This
    // ORs with the /config/{id} block above (Firestore grants if either
    // allows), so admin retains write access regardless.
    match /config/timeline {
      allow read: if isKnownUser();
      allow write: if isAdmin()
        || (isSignedIn() && resource != null && request.auth.token.email in resource.data.viewers);
    }

    // Related Role — grow-only self-service (2026-07-06): any known user
    // typing a brand-new role into the New Entry / Edit form can append it
    // to the shared list, WITHOUT admin rights. Scoped tight so this can't
    // be used to touch any other schema field or to remove existing roles:
    //   - affectedKeys().hasOnly(['relatedRole']) — no other field in
    //     /config/schema is writable this way.
    //   - hasAll(resource.data.relatedRole) — the new array must be a
    //     superset of the old one (append-only, never shrinks/reorders away
    //     existing values). Combined with isKnownUser()'s doc.create being
    //     admin-only via /config/{id} above, this can only ever grow the list.
    // ORs with /config/{id} above, so admin retains full-doc write regardless.
    match /config/schema {
      allow update: if isKnownUser()
        && affectedKeys().hasOnly(['relatedRole'])
        && request.resource.data.relatedRole is list
        && (!('relatedRole' in resource.data) || request.resource.data.relatedRole.hasAll(resource.data.relatedRole));
    }

    // Team — grow-only self-service (2026-08-10), same shape as relatedRole
    // above: PreRegModal's Owner field lets any known user type a team name
    // not yet in the canonical list and have it appended, without admin
    // rights. Separate match block (not merged into the relatedRole one)
    // because affectedKeys().hasOnly(['relatedRole']) would otherwise also
    // have to list 'team', and a single write must touch only one growable
    // field at a time — keeping them as two single-field rules is what
    // guarantees a write can never grow two lists at once under one exploit.
    match /config/schema {
      allow update: if isKnownUser()
        && affectedKeys().hasOnly(['team'])
        && request.resource.data.team is list
        && (!('team' in resource.data) || request.resource.data.team.hasAll(resource.data.team));
    }

    // ── Workshop (2026-09-16, revamped) ──────────────────────────────
    // A live-workshop facilitation board layered on top of the SDLC catalog.
    // Isolated from the main Library entirely: no rule here ever touches
    // /agents, /sdlcProcesses, /sdlcUseCases, or /config/schema. Page
    // visibility ('workshop' role + staff/committee/admin) is enforced
    // client-side by the menu gate; these rules are the actual boundary.
    //
    // config/workshopSchema is superseded by workshopTeams below and no
    // longer has any rule (the old doc is left in place in Firestore,
    // unused, rather than deleted — out of scope to touch further).

    // One doc per team. Any workshop+ role can create their own team.
    // Rename/delete/membership (destructive/sensitive ops) are admin-only
    // (2026-09-17 — tightened from staff+ since the UI entry point, the
    // Team & User Management panel, is admin-only now).
    match /workshopTeams/{id} {
      allow read: if isKnownUser();
      allow create: if isWorkshopOrAbove()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string;
      allow update: if isAdmin()
        && request.resource.data.name is string;
      allow delete: if isAdmin();
    }

    // Team-number assignment counter (2026-09-17). Lives under /config but
    // needs its own literal match — the generic /config/{id} wildcard below
    // requires isAdmin() for writes, which is wrong here: any workshop+
    // participant runs this transaction when they create a team. A literal
    // match here overrides the wildcard, same pattern as /config/schema.
    match /config/workshopTeamCounter {
      allow read: if isKnownUser();
      allow write: if isWorkshopOrAbove();
    }

    // One doc per idea pinned to a process card ("sticker"), tracked through
    // a status pipeline (2026-09-17 — replaces the old flat pain/improvement
    // `kind` tag for this collection only; ideationStickers is untouched and
    // keeps its own independent kind). create: any workshop+ role. Full-edit
    // (team/description) update or delete: staff+ can act on any sticker, a
    // workshop+ creator can only act on their own. Status transitions are a
    // SEPARATE allow-update branch below with their own actor + sequencing
    // rules, since "who can edit the text" and "who can advance status" are
    // different audiences (team members who never created the idea can still
    // advance it).
    match /workshopIdeas/{ideaId} {
      allow read: if isKnownUser();
      allow create: if isWorkshopOrAbove()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.processId is string
        && request.resource.data.team is string
        && request.resource.data.teamId is string
        && request.resource.data.ideaName is string
        && request.resource.data.ideaName.size() <= 100
        && request.resource.data.status == 'idea';

      // Full-edit branch (rename team / edit short description). Explicitly
      // forbidden from touching status/skillName so this path can never be
      // used to spoof a status transition.
      allow update: if (
          isStaffOrAbove()
          || (isWorkshopOrAbove() && resource.data.createdBy == request.auth.uid)
        )
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'skillName']);

      // Status-transition branch: staff+, the creator, or a member of the
      // idea's team (looked up by teamId — guarded with .get() defaults so
      // pre-this-round idea docs with no teamId, or team docs with no
      // members yet, can never accidentally satisfy this). Strictly
      // sequential, one step, no skip, no revert; the qa->done step also
      // requires a non-empty skillName in the same write.
      allow update: if isWorkshopOrAbove()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'skillName', 'updatedAt'])
        && (
          isStaffOrAbove()
          || resource.data.createdBy == request.auth.uid
          || (
            resource.data.get('teamId', '') != ''
            && request.auth.uid in get(/databases/$(database)/documents/workshopTeams/$(resource.data.get('teamId', 'x'))).data.get('members', [])
          )
        )
        && (
          (resource.data.status == 'idea' && request.resource.data.status == 'dev')
          || (resource.data.status == 'dev' && request.resource.data.status == 'qa')
          || (resource.data.status == 'qa' && request.resource.data.status == 'done'
              && request.resource.data.skillName is string
              && request.resource.data.skillName.size() > 0)
        );

      allow delete: if isStaffOrAbove()
        || (isWorkshopOrAbove() && resource.data.createdBy == request.auth.uid);
    }

    // Anonymous Ideation-tab stickers: no team/name/use-case fields at all,
    // uncapped, create/delete only (never edited). Delete: creator or staff+.
    match /ideationStickers/{id} {
      allow read: if isKnownUser();
      allow create: if isWorkshopOrAbove()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.processId is string
        && request.resource.data.kind in ['pain', 'improvement'];
      allow delete: if isStaffOrAbove()
        || (isWorkshopOrAbove() && resource.data.createdBy == request.auth.uid);
    }

    // ── /categoryProposals — AI-proposed new Category shortcuts ──────
    // Written whenever analyzeDuplicate (or the backfill script) decides a
    // draft/agent is novel enough that no existing /config/schema.category
    // value fits well. The agent itself is NEVER left uncategorized while a
    // proposal is pending — the client always writes a real (fallback)
    // category on the agent doc alongside this proposal, so this collection
    // only gates whether a NEW shortcut appears in the sidebar, never
    // findability of the agent itself.
    match /categoryProposals/{id} {
      allow read: if isKnownUser();
      // Submitter self-creates their own proposal row; can't forge another.
      allow create: if isKnownUser()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending';
      // Only admin approves/rejects (per 2026-08 decision: admin-only gate on
      // new categories, to avoid repeating relatedRole's 54-value sprawl).
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── /analysisRuns — duplicate-check knowledge base ───────────────
    // One doc per submitted analysis (doc id = the agent's id). Written by the
    // submitter at submit time; the human outcome (approved/rejected) is
    // attached later by whoever can act on the pending item.
    match /analysisRuns/{id} {
      allow read: if isKnownUser();
      // Submitter self-creates their own run; can't forge another creator.
      allow create: if isKnownUser()
        && request.resource.data.createdBy == request.auth.uid;
      // Outcome update: approver/committee/admin, and only the outcome fields.
      allow update: if isApproverOrAbove()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['outcome', 'outcomeBy', 'outcomeAt']);
      allow delete: if isAdmin();
    }
  }
}
