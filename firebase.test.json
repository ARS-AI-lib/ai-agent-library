{
  "hosting": [
    {
      "site": "wolfy-ai-library-test",
      "public": "dist-test",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        }
      ]
    }
  ],
  "firestore": [
    {
      "database": "ai-agent-lib-test",
      "rules": "firestore.rules"
    }
  ],
  "functions": [
    {
      "source": "functions-test",
      "codebase": "test",
      "prefix": "test",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ]
}
